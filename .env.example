# Helius dashboard API key. Parsed Streams is currently a paid-plan beta product.
HELIUS_API_KEY=

# The public base URL Helius can reach. Example: https://scanner.example.com
# FlowWatch registers ${PUBLIC_URL}/webhook/helius with Helius by itself at startup.
# On Railway this is derived from RAILWAY_PUBLIC_DOMAIN — leave it unset there.
# A localhost value disables webhook registration and is reported in the UI.
PUBLIC_URL=http://localhost:3000

# Telegram is optional globally; a config-specific chat ID takes precedence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Optional: set only if Helius changes its beta Parsed Streams endpoint.
# PARSED_STREAM_URL=wss://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Optional: directory for runtime JSON state. Set to the Railway volume mount
# path (e.g. /app/data) so configs and alerts survive a redeploy.
# DATA_DIR=/app/data

# Postgres connection string. When set, FlowWatch stores rules, watches, alerts
# and the full event history in Postgres instead of data/*.json — the JSON files
# are only used as a fallback for local development.
# On Railway, add a PostgreSQL service and set: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:password@host:5432/railway
